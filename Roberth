<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Motoflash</title>
  <link rel="manifest" href="manifest.json">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f4f4f4;
      color: #222;
    }

    header {
      background: #111;
      color: white;
      padding: 18px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
    }

    .logo span {
      color: #ffcc00;
    }

    .menu {
      font-size: 25px;
    }

    .hero {
      background: linear-gradient(135deg, #111, #292929);
      color: white;
      padding: 35px 20px;
      text-align: center;
    }

    .hero h1 {
      font-size: 30px;
      margin-bottom: 10px;
    }

    .hero span {
      color: #ffcc00;
    }

    .hero p {
      color: #ddd;
      line-height: 1.5;
    }

    .container {
      max-width: 650px;
      margin: auto;
      padding: 25px 18px;
    }

    .card {
      background: white;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 18px;
      box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

    .card h2 {
      margin-bottom: 15px;
    }

    .btn {
      width: 100%;
      background: #ffcc00;
      color: #111;
      border: none;
      border-radius: 8px;
      padding: 14px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 8px;
    }

    .btn-dark {
      background: #111;
      color: white;
    }

    .tabs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 20px;
    }

    .tab {
      padding: 14px;
      border: none;
      border-radius: 8px;
      background: #ddd;
      font-weight: bold;
      cursor: pointer;
    }

    .tab.active {
      background: #ffcc00;
    }

    .area {
      display: none;
    }

    .area.active {
      display: block;
    }

    label {
      display: block;
      margin-top: 14px;
      margin-bottom: 6px;
      font-weight: bold;
      font-size: 14px;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #ddd;
      border-radius: 7px;
      font-size: 15px;
    }

    input:focus {
      outline: none;
      border-color: #ffcc00;
    }

    .info {
      background: #fff8d6;
      border-left: 4px solid #ffcc00;
      padding: 13px;
      margin-top: 15px;
      border-radius: 5px;
      font-size: 14px;
      line-height: 1.5;
    }

    .resumo {
      display: none;
      margin-top: 20px;
      background: #111;
      color: white;
      padding: 18px;
      border-radius: 10px;
    }

    .resumo h3 {
      color: #ffcc00;
      margin-bottom: 12px;
    }

    .valor {
      display: flex;
      justify-content: space-between;
      padding: 7px 0;
      border-bottom: 1px solid #333;
    }

    .valor:last-child {
      border-bottom: none;
    }

    .entrega {
      background: #fafafa;
      border: 1px solid #ddd;
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 12px;
    }

    .entrega h3 {
      margin-bottom: 10px;
    }

    .entrega p {
      margin: 6px 0;
      color: #555;
      font-size: 14px;
    }

    .valor-motoboy {
      background: #d9ffd9;
      color: #168316;
      padding: 12px;
      border-radius: 8px;
      margin-top: 12px;
      font-weight: bold;
      text-align: center;
      font-size: 18px;
    }

    .status {
      display: inline-block;
      margin-top: 10px;
      padding: 6px 10px;
      border-radius: 20px;
      background: #fff0c2;
      color: #8a6500;
      font-size: 11px;
      font-weight: bold;
    }

    .vazio {
      text-align: center;
      color: #777;
      padding: 20px 5px;
    }

    footer {
      background: #111;
      color: #aaa;
      text-align: center;
      padding: 25px;
      font-size: 13px;
      margin-top: 20px;
    }

    @media (max-width: 400px) {
      .hero h1 {
        font-size: 25px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="logo">Moto<span>flash</span></div>
  <div class="menu">🏍️</div>
</header>

<section class="hero">
  <h1>Central de <span>Entregas</span></h1>
  <p>Conectando restaurantes e motoboys.</p>
</section>

<div class="container">

  <div class="tabs">
    <button class="tab active" onclick="mostrarArea('restaurante', this)">🏪 Restaurante</button>
    <button class="tab" onclick="mostrarArea('motoboy', this)">🏍️ Motoboy</button>
  </div>

  <div id="restaurante" class="area active">
    <div class="card">
      <h2>📦 Solicitar motoboy</h2>
      <div class="info">
        A taxa de entrega não pode ser menor que <strong>R$ 7,00</strong>.
      </div>

      <label>Nome do restaurante</label>
      <input type="text" id="restauranteNome" placeholder="Ex.: Lanchonete do João">

      <label>Endereço de retirada</label>
      <input type="text" id="retirada" placeholder="Onde o motoboy vai buscar?">

      <label>Endereço de entrega</label>
      <input type="text" id="entrega" placeholder="Onde será entregue?">

      <label>Valor da taxa de entrega</label>
      <input type="number" id="taxa" min="7" step="0.01" placeholder="Ex.: 10.00" oninput="calcularValores()">

      <label>Observação</label>
      <input type="text" id="observacao" placeholder="Ex.: Pedido #125">

      <div class="resumo" id="resumo">
        <h3>💰 Resumo da entrega</h3>
        <div class="valor">
          <span>Taxa da entrega:</span>
          <strong id="valorBruto">R$ 0,00</strong>
        </div>
        <div class="valor">
          <span>Comissão Motoflash:</span>
          <strong id="valorComissao">R$ 0,00</strong>
        </div>
        <div class="valor">
          <span>Motoboy recebe:</span>
          <strong id="valorMotoboy">R$ 0,00</strong>
        </div>
      </div>

      <button class="btn" onclick="criarEntrega()">🚀 Solicitar Motoboy</button>
    </div>

    <div class="card">
      <h2>💳 Plano do restaurante</h2>
      <p>O restaurante paga <strong>R$ 100,00 por mês</strong> para utilizar o Motoflash.</p>
    </div>
  </div>

  <div id="motoboy" class="area">
    <div class="card">
      <h2>🏍️ Entregas disponíveis</h2>
      <div id="listaEntregas">
        <div class="vazio">Nenhuma entrega disponível no momento.</div>
      </div>
    </div>
  </div>

</div>

<footer>
  © 2026 Motoflash<br>
  Plataforma de entregas
</footer>

<script>
  const porcentagemMotoflash = 20;
  let entregas = [];

  function mostrarArea(area, botao) {
    document.querySelectorAll(".area").forEach(item => item.classList.remove("active"));
    document.querySelectorAll(".tab").forEach(item => item.classList.remove("active"));
    document.getElementById(area).classList.add("active");
    botao.classList.add("active");
    if (area === "motoboy") mostrarEntregas();
  }

  function calcularValores() {
    const taxa = parseFloat(document.getElementById("taxa").value);
    const resumo = document.getElementById("resumo");
    if (isNaN(taxa) || taxa < 7) {
      resumo.style.display = "none";
      return;
    }
    const comissao = taxa * (porcentagemMotoflash / 100);
    const motoboy = taxa - comissao;
    document.getElementById("valorBruto").innerText = formatarMoeda(taxa);
    document.getElementById("valorComissao").innerText = formatarMoeda(comissao);
    document.getElementById("valorMotoboy").innerText = formatarMoeda(motoboy);
    resumo.style.display = "block";
  }

  function criarEntrega() {
    const restaurante = document.getElementById("restauranteNome").value.trim();
    const retirada = document.getElementById("retirada").value.trim();
    const entrega = document.getElementById("entrega").value.trim();
    const taxa = parseFloat(document.getElementById("taxa").value);
    const observacao = document.getElementById("observacao").value.trim();

    if (!restaurante) return alert("Digite o nome do restaurante.");
    if (!retirada) return alert("Digite o endereço de retirada.");
    if (!entrega) return alert("Digite o endereço de entrega.");
    if (isNaN(taxa) || taxa < 7) return alert("A taxa de entrega não pode ser menor que R$ 7,00.");

    const comissao = taxa * (porcentagemMotoflash / 100);
    const valorMotoboy = taxa - comissao;

    const novaEntrega = {
      id: Date.now(),
      restaurante,
      retirada,
      entrega,
      taxa,
      comissao,
      valorMotoboy,
      observacao,
      status: "Disponível"
    };

    entregas.push(novaEntrega);
    salvarEntregas();
    alert("Entrega criada com sucesso! 🚀");

    document.getElementById("restauranteNome").value = "";
    document.getElementById("retirada").value = "";
    document.getElementById("entrega").value = "";
    document.getElementById("taxa").value = "";
    document.getElementById("observacao").value = "";
    document.getElementById("resumo").style.display = "none";

    mostrarEntregas();
  }

  function mostrarEntregas() {
    carregarEntregas();
    const lista = document.getElementById("listaEntregas");
    if (entregas.length === 0) {
      lista.innerHTML = `<div class="vazio">Nenhuma entrega disponível no momento.</div>`;
      return;
    }
    lista.innerHTML = "";
    entregas.forEach(item => {
      const div = document.createElement("div");
      div.className = "entrega";
      div.innerHTML = `
        <h3>📦 ${item.restaurante}</h3>
        <p><strong>Retirada:</strong> ${item.retirada}</p>
        <p><strong>Entrega:</strong> ${item.entrega}</p>
        <p><strong>Pedido:</strong> ${item.observacao || "Não informado"}</p>
        <div class="valor-motoboy">🏍️ Você recebe: ${formatarMoeda(item.valorMotoboy)}</div>
        <span class="status">${item.status}</span>
        ${item.status === "Disponível"
          ? `<button class="btn" onclick="aceitarEntrega(${item.id})">🏍️ Aceitar entrega</button>`
          : item.status === "Aceita"
          ? `<button class="btn btn-dark" onclick="finalizarEntrega(${item.id})">✅ Finalizar entrega</button>`
          : `<p style="margin-top:12px; color:#168316; font-weight:bold;">Entrega concluída ✅</p>`
        }
      `;
      lista.appendChild(div);
    });
  }

  function aceitarEntrega(id) {
    const entrega = entregas.find(item => item.id === id);
    if (!entrega) return;
    entrega.status = "Aceita";
    salvarEntregas();
    alert("Entrega aceita! 🏍️");
    mostrarEntregas();
  }

  function finalizarEntrega(id) {
    const entrega = entregas.find(item => item.id === id);
    if (!entrega) return;
    entrega.status = "Concluída";
    salvarEntregas();
    alert("Entrega finalizada! ✅\n\nVocê recebeu: " + formatarMoeda(entrega.valorMotoboy));
    mostrarEntregas();
  }

  function formatarMoeda(valor) {
    return valor.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
  }

  function salvarEntregas() {
    localStorage.setItem("motoflash_entregas", JSON.stringify(entregas));
  }

  function carregarEntregas() {
    const dados = localStorage.getItem("motoflash_entregas");
    if (dados) entregas = JSON.parse(dados);
  }
</script>

</body>
</html>
